# Session signing secret (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SESSION_SECRET=

# ── Plan d'entrainement d'exemple ───────────────────────────────────────────
# Laisse les dates vides pour demarrer au prochain jeudi avec une course 108
# jours plus tard, ou renseigne ton propre calendrier au format YYYY-MM-DD.
PLAN_RACE_NAME=Marathon
PLAN_START_DATE=
PLAN_RACE_DATE=
# PLAN_DESCRIPTION=Mon plan de 16 semaines

# ── Local (self-hosted) ──────────────────────────────────────────────────────
# Public URL of the app (used for OAuth redirect and cookies)
BASE_URL=http://localhost:8080

# Optional: Additional CORS origins (comma-separated)
# ALLOWED_ORIGINS=http://localhost:5173

# Local Postgres — the PRIMARY store for the self_hosted branch.
# scripts/start.sh runs the backend on this URL and replicates every write back
# to Neon. The local DB is only bootstrapped from Neon once, while it is still
# empty (it is never clobbered).
# Install:  brew install postgresql@16 && brew services start postgresql@16
#           createdb strava
LOCAL_DATABASE_URL=postgresql://localhost:5432/strava

# DATABASE_URL is the active PRIMARY database. In self_hosted it should be the
# local Postgres URL. scripts/start.sh also exports DATABASE_URL=$LOCAL_DATABASE_URL
# at runtime, so the refresh writes local first.
DATABASE_URL=postgresql://localhost:5432/strava

# Neon is the SECONDARY replica for self_hosted. Fresh Garmin data written to the
# local primary is pushed here best-effort so the Vercel deployment can read it.
DATABASE_URL_NEON=postgresql://neon_user:pass@ep-xxx.neon.tech/strava?sslmode=require

# Optional SQL snapshot kept in sync on self_hosted startup.
# LOCAL_DATABASE_SQL_PATH=.runtime/local-db/bdd_runs.sql

# Legacy format still works: if DATABASE_URL contains Neon and LOCAL_DATABASE_URL
# is set, scripts/start.sh moves that Neon URL to DATABASE_URL_NEON and flips
# DATABASE_URL to the local primary before launching the backend.

# Replication is best-effort and never blocks a request. After the secondary DB
# refuses a write it is skipped for this many seconds (circuit breaker).
# DB_SECONDARY_COOLDOWN=120

# ── Vercel ───────────────────────────────────────────────────────────────────
# Uncomment and set these in your Vercel project settings (not in this file):
#
# BASE_URL=https://<ton-projet>.vercel.app
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require   # Neon = primary
#
# DATABASE_URL tells the app to use Neon PostgreSQL instead of local SQLite.
# Get it from https://console.neon.tech → your project → Connection Details.
#
# Optional secondary replica from Vercel -> your local Postgres. Only works if
# the address is reachable from Vercel's runtime (localhost there is the Vercel
# container, NOT your Mac) — use a public/tunnelled host. Replication is
# best-effort: it is skipped (circuit breaker) when the host is unreachable.
# LOCAL_DATABASE_URL=postgresql://user:pass@your-public-host:5432/strava
